# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Anthropic (required for live LLM responses) ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Conversational chat model (structured JSON replies). Use an id from your Anthropic console.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Max tokens per chat completion (raise if replies truncate)
ANTHROPIC_MAX_TOKENS=1024

# --- App limits (see docs/API_CONTRACT.md) ---
MAX_MESSAGE_LENGTH=2000
MAX_SESSION_TURNS=10

# Per-session and per-IP limits on POST /api/v1/chat (see mindcare/rate_limiter.py)
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300

# If the model returns empty reply_text, this string is used instead
EMPTY_REPLY_FALLBACK="I'm here with you."

# --- CORS (browser chat UI on another origin, e.g. Vercel) ---
# Comma-separated list, no spaces. Include Vite (5173) and any deployed UI origin.
MINDCARE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Chat pipeline debug (local / staging only; may log message snippets) ---
# Repo-root .env only (not web/.env). Restart uvicorn after changes.
MINDCARE_CHAT_DEBUG=false

# --- LLM safety router (recommended for production) ---
# When true: one Haiku classify_safety_turn before the chat LLM; legacy medium phrase regex is
# skipped; medium vs low comes from the classifier. Hard gates (crisis, harm-how-to, injection)
# are unchanged. See docs/BACKEND_CHAT_ROUTING.md and docs/LLM_SAFETY_ROUTER_PLAN.md.
# Code default is false (pytest keeps router off). Set true in your real .env for prod-like behavior.
MINDCARE_USE_LLM_ROUTER=true

# Classifier model (fast/cheap). If empty, ANTHROPIC_MODEL is used for classify_safety_turn.
MINDCARE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
MINDCARE_CLASSIFIER_MAX_TOKENS=256

# Staging only: log a short preview of classifier rationale (keep false in production).
MINDCARE_CLASSIFIER_LOG_RATIONALE=false

# When crisis keywords match but wording is not inherently first-person, one classifier call
# chooses first-person crisis template (§1) vs supporter template (§1a). Uses the same model as
# MINDCARE_CLASSIFIER_MODEL. Default true; false → always first-person template.
MINDCARE_CRISIS_PERSPECTIVE_LLM=true

# Router on + trusted classifier merged LOW: soft empathy cues to the chat LLM when
# intent_bucket is distress / ambiguous_distress / hopelessness (no extra API call).
MINDCARE_SOFT_EMPATHY_HINTS=true

# --- Testing only (not read by the API runtime) ---
# Opt-in live integration smoke: tests/test_integration_chat.py (requires ANTHROPIC_API_KEY).
# MINDCARE_RUN_INTEGRATION=1

# Optional base URL for scripts/sample_chat_responses.py (not read by the API).
# MINDCARE_API_BASE=http://127.0.0.1:8000

# --- Process binding (not read by the app — pass to uvicorn yourself) ---
# Local:  uvicorn mindcare.main:app --host 0.0.0.0 --port 8000
# Render: set PORT in the dashboard; start command uses ${PORT}
