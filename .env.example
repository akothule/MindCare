# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Anthropic (required for live LLM responses) ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model id (must exist for your API key — copy from Anthropic console or docs)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Max tokens for each completion (raise if replies truncate)
ANTHROPIC_MAX_TOKENS=1024

# --- App limits (see docs/API_CONTRACT.md) ---
MAX_MESSAGE_LENGTH=2000
MAX_SESSION_TURNS=10

# If the model returns empty reply_text, this string is used instead
EMPTY_REPLY_FALLBACK="I'm here with you."

# --- CORS (browser chat UI on another origin, e.g. Vercel) ---
# Comma-separated list, no spaces. Include Vite (5173) and any deployed UI origin.
MINDCARE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Chat pipeline debug (local / staging only; may log message snippets) ---
# Set to true or 1 for [chat-debug] lines (WARNING level) on each POST /api/v1/chat.
# Repo-root .env only (not web/.env). Restart uvicorn. Shell `export` overrides .env if set.
MINDCARE_CHAT_DEBUG=false

# --- LLM safety router (optional second Anthropic call before the chat completion) ---
# Default false: same behavior as before (regex pre-classification + single chat LLM only).
# See docs/LLM_SAFETY_ROUTER_PLAN.md. Phase 1 logs classifier output; routing merge is Phase 2.
MINDCARE_USE_LLM_ROUTER=false
# Optional: smaller/faster model id for the classifier; if empty, ANTHROPIC_MODEL is used.
MINDCARE_CLASSIFIER_MODEL=
MINDCARE_CLASSIFIER_MAX_TOKENS=256
# Staging only: log a short preview of classifier rationale (keep false in production).
MINDCARE_CLASSIFIER_LOG_RATIONALE=false

# When crisis keywords match but wording is not inherently first-person, call the safety classifier
# (Haiku if MINDCARE_CLASSIFIER_MODEL is set) once for §1 vs §1a. Default true; false → always §1.
MINDCARE_CRISIS_PERSPECTIVE_LLM=true

# When router is on + trusted classifier merged LOW: send short soft-empathy cues to the chat LLM when
# intent_bucket is distress / ambiguous_distress / hopelessness (no extra Haiku). Router off: still
# tied to regex medium match + merged low. Default true.
MINDCARE_SOFT_EMPATHY_HINTS=true

# Opt-in only: pytest live integration test (tests/test_integration_chat.py). Not read by the API runtime.
# MINDCARE_RUN_INTEGRATION=1

# --- Process binding (not read by the app — pass to uvicorn yourself) ---
# Local:  uvicorn mindcare.main:app --host 0.0.0.0 --port 8000
# Render: set PORT in the dashboard; start command uses ${PORT}
